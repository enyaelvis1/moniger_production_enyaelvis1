# Frontend environment for local Supabase CLI development.
# Copy to .env.local after running `supabase start` and fill in the local publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-supabase-publishable-key
VITE_PUBLIC_APP_URL=http://localhost:8080
VITE_APP_BASE_URL=http://localhost:8080
VITE_SENTRY_ENVIRONMENT=local
